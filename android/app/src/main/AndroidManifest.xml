<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declares intent to use USB MIDI devices, not a runtime permission -- android.media.midi
         itself needs none (unlike RECORD_AUDIO, which this app also never asks for: it never
         captures, only renders). required="false" so the app still installs on a device with no
         MIDI hardware feature flag at all; MidiManager.getDevices() is simply empty there. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.software.midi" android:required="false" />

    <application
        android:label="HDS Backend Test"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
