<?xml version="1.0" encoding="utf-8"?>
<!-- package= here (not just build.gradle's namespace) because this build is currently assembled
     by hand with aapt2/d8/apksigner, not Gradle/AGP (see android/README.md): AGP normally
     derives this from build.gradle's own namespace instead; drop this if a real Gradle build
     becomes possible here and AGP starts complaining about the two disagreeing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hds.androidtest">

    <!-- Declares intent to use USB MIDI devices, not a runtime permission: android.media.midi
         itself needs none (unlike RECORD_AUDIO, which this app also never asks for: it never
         captures, only renders). required="false" so the app still installs on a device with no
         MIDI hardware feature flag at all; MidiManager.getDevices() is simply empty there. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.software.midi" android:required="false" />

    <application
        android:label="HDS Backend Test"
        android:allowBackup="false">
        <!-- .NoActionBar.Fullscreen, not plain Theme.Material.Light: the real native GUI
             (HdsSurfaceView, see MainActivity.java's own header comment) fills the whole screen
             now, so the system ActionBar the plain theme used to add above it (a real, visible
             white bar, left over from when this build's only content was a status TextView) has
             nowhere left to put anything, and Fullscreen additionally drops the status bar.
             MainActivity.java's own immersive-mode call (hides the nav bar too, re-asserted on
             every focus change) covers what this theme alone doesn't. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout"
            android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
