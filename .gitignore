synth_engine
hds.clap
hds_fx.clap
hds-windows.clap
hds_fx-windows.clap
synth_engine-arm64
/arm64-libs/
# Cross-built Windows CLAP dependencies (Cairo/pixman/liblo) -- see tools/build_windows_deps.sh,
# not checked in, same reasoning as /arm64-libs/ above.
/third_party/win64-deps/
*.o
# The whole build/ output dir, not just *.o inside it -- NAM_FLAGS_STAMP/ARM64_NAM_FLAGS_STAMP
# (see Makefile) now also live here as plain non-.o stamp files, which *.o alone doesn't cover.
/build/
# Android: machine-local SDK/NDK path (Gradle regenerates this itself on first sync) and every
# Gradle/CMake output directory -- same reasoning as /build/ above, just Android's own layout.
/android/local.properties
/android/.gradle/
/android/.idea/
/android/build/
/android/app/build/
/android/app/.cxx/
# The compiled native lib is a build OUTPUT (same reasoning as every other entry in this file --
# never commit a binary this repo's own tooling can produce), whether it lands here via
# tools/build_android_manual.sh or a real externalNativeBuild/CMake run.
/android/app/src/main/jniLibs/
# nix-build's own output symlink when run from the repo root without -o -- same reasoning as
# /build/ above, just Nix's own convention instead of this project's Makefile.
/result

