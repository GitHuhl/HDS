# HDS build. Run inside `nix-shell` (it pins every dependency and sets the cross-toolchain variables).
#
#   make              -> synth_engine            make test         build + run tests/ against tests/golden.txt
#   make clap         -> hds.clap                make test-golden  same, rewriting tests/golden.txt
#   make hds-fx       -> hds_fx.clap             make clean        remove build/ and every product
#   make arm64        -> synth_engine-arm64 (+ arm64-libs/, for a Raspberry Pi 5)
#   make clap-windows / hds-fx-windows -> hds-windows.clap / hds_fx-windows.clap
#                                         (run tools/build_windows_deps.sh once first)
#
# How it's organized: every object is built from src/<path>.c into build/<variant>/<path>.o by one
# pattern rule per variant, with header dependencies generated by the compiler (-MMD). The variants:
#   linux     native, -fPIC -fvisibility=hidden: everything that's linked into a .clap
#   linux-sa  native, standalone-only code: the standalone GUI/PipeWire flags, no PIC needed
#   arm64     aarch64 cross-build (ARM64_* from nix-shell)
#   win       mingw-w64 cross-build (WIN_* from nix-shell)
# Each product is then just a list of units. Background on the less obvious flags and link
# choices (NAM visibility, mingw pthreads, static linking, arm64 bundling, ...) is in
# docs/building.md.

CC ?= cc
CXX ?= g++
CFLAGS ?= -O2 -Wall -Wextra -std=gnu11
# Every project #include is relative to src/ (e.g. "core/backend.h"); the CLAP SDK is <clap/clap.h>.
override CFLAGS += -Isrc -Ithird_party/clap/include
STRIPFLAGS := -s
LDLIBS := -lasound -lm -lpthread -llo -lwavpack
BUILD_DIR := build

# PipeWire is optional (ALSA is always available): enabled when pkg-config finds libpipewire-0.3.
PIPEWIRE_AVAILABLE := $(shell pkg-config --exists libpipewire-0.3 && echo 1 || echo 0)
ifeq ($(PIPEWIRE_AVAILABLE),1)
PIPEWIRE_CFLAGS := -DHDS_PIPEWIRE_ENABLED=1 $(shell pkg-config --cflags libpipewire-0.3)
PIPEWIRE_LDLIBS := $(shell pkg-config --libs libpipewire-0.3)
else
PIPEWIRE_CFLAGS := -DHDS_PIPEWIRE_ENABLED=0
PIPEWIRE_LDLIBS :=
endif
$(info PipeWire backend (--backend pipewire): $(if $(filter 1,$(PIPEWIRE_AVAILABLE)),enabled,disabled -- libpipewire-0.3 not found via pkg-config))

GUI_CFLAGS := $(shell pkg-config --cflags cairo x11)
GUI_LDLIBS := $(shell pkg-config --libs cairo x11)

# --- Neural Amp Modeler (vendored C++, FX_TYPE_NAM) -- see docs/building.md ---
NAM_DIR := third_party/NeuralAmpModelerCore
NAM_INC := -I$(NAM_DIR) -I$(NAM_DIR)/Dependencies/nlohmann -Ithird_party/eigen
NAM_CXXFLAGS := -O2 -std=c++20 -fPIC -fvisibility=hidden -fvisibility-inlines-hidden -DNAM_SAMPLE_FLOAT $(NAM_INC) -Isrc
NAM_UNITS := activations container conv1d convnet dsp get_dsp linear lstm nam_file ring_buffer \
             sequential util wav a2_fast model slimmable nam_bridge

# --- Source units, by subsystem (paths under src/, no extension) ---
CORE_UNITS  := core/backend core/render core/voices core/midi_dispatch core/arpeggiator core/metronome core/defaults \
               core/fx_upload core/program_files core/json core/tuning core/smf_import core/sfz_parser core/osc_protocol core/sample_engine
FX_UNITS    := fx/fx_chain $(addprefix fx/,fx_airwindows_mod fx_airwindows_tone fx_nam fx_eq_filter \
               fx_compressors fx_limiters fx_pitch fx_reverb_delay)
FX_GUI_UNITS := gui/hds_fx_gui_draw gui/hds_fx_gui_browser
# Synth GUI tabs: six are identical in both hosts; four contain standalone-only code and are built
# per host (see src/gui/hds_clap_gui.h).
TABS_SHARED   := $(patsubst %,gui/hds_clap_%_draw,play combi filters lfos envelopes global)
TABS_PER_HOST := $(patsubst %,gui/hds_clap_%_draw,routing devices recording gui)
STANDALONE_UNITS := targets/standalone/hds_standalone core/recording_engine core/sequencer

objs     = $(addprefix $(BUILD_DIR)/$(1)/,$(addsuffix .o,$(2)))
nam_objs = $(addprefix $(BUILD_DIR)/$(1)/nam/,$(addsuffix .o,$(NAM_UNITS)))

# --- Per-variant compile rules ---
# $(1) variant, $(2) C compiler, $(3) C flags, $(4) C++ compiler for NAM
define variant_rules
$(BUILD_DIR)/$(1)/%.o: src/%.c
	@mkdir -p $$(@D)
	$(2) $(3) -MMD -MP -c $$< -o $$@
# NAM's objects also depend on a stamp of its flags, so changing NAM_CXXFLAGS rebuilds them.
$(BUILD_DIR)/$(1)/nam/.flags: FORCE
	@mkdir -p $$(@D)
	@if [ "$$$$(cat $$@ 2>/dev/null)" != '$$(NAM_CXXFLAGS)' ]; then echo '$$(NAM_CXXFLAGS)' > $$@; fi
$(BUILD_DIR)/$(1)/nam/%.o: $(NAM_DIR)/NAM/%.cpp $(BUILD_DIR)/$(1)/nam/.flags
	$(4) $$(NAM_CXXFLAGS) -MMD -MP -c $$< -o $$@
$(BUILD_DIR)/$(1)/nam/%.o: $(NAM_DIR)/NAM/wavenet/%.cpp $(BUILD_DIR)/$(1)/nam/.flags
	$(4) $$(NAM_CXXFLAGS) -MMD -MP -c $$< -o $$@
$(BUILD_DIR)/$(1)/nam/%.o: src/fx/%.cpp $(BUILD_DIR)/$(1)/nam/.flags
	$(4) $$(NAM_CXXFLAGS) -MMD -MP -c $$< -o $$@
endef
$(eval $(call variant_rules,linux,$$(CC),$$(CFLAGS) $$(GUI_CFLAGS) $$(NAM_INC) -fPIC -fvisibility=hidden,$$(CXX)))
$(eval $(call variant_rules,linux-sa,$$(CC),$$(CFLAGS) $$(GUI_CFLAGS) $$(PIPEWIRE_CFLAGS) -DHDS_STANDALONE_GUI_ENABLED=1,$$(CXX)))
$(eval $(call variant_rules,arm64,$$(ARM64_CC),$$(CFLAGS) $$(ARM64_CFLAGS),$$(ARM64_CXX)))
$(eval $(call variant_rules,win,$$(WIN_CC),$$(WIN_CFLAGS),$$(WIN_CXX)))
FORCE:

.PHONY: all clap hds-fx arm64 clap-windows hds-fx-windows test test-golden clean clean-windows run-backend FORCE
all: synth_engine

# --- Native Linux products ---
SYNTH_OBJS  := $(call objs,linux,$(CORE_UNITS) $(FX_UNITS) $(FX_GUI_UNITS) $(TABS_SHARED)) \
               $(call objs,linux-sa,$(STANDALONE_UNITS) $(TABS_PER_HOST)) $(call nam_objs,linux)
CLAP_OBJS   := $(call objs,linux,targets/clap/clap_plugin $(CORE_UNITS) $(FX_UNITS) $(FX_GUI_UNITS) $(TABS_SHARED) $(TABS_PER_HOST)) \
               $(call nam_objs,linux)
HDS_FX_OBJS := $(call objs,linux,targets/fx_clap/hds_fx_plugin $(FX_UNITS) $(FX_GUI_UNITS)) $(call nam_objs,linux)

synth_engine: $(SYNTH_OBJS)
	$(CXX) $(STRIPFLAGS) -o $@ $^ $(LDLIBS) $(PIPEWIRE_LDLIBS) $(GUI_LDLIBS)
hds.clap: $(CLAP_OBJS)
	$(CXX) $(STRIPFLAGS) -shared -o $@ $^ $(LDLIBS) $(GUI_LDLIBS)
hds_fx.clap: $(HDS_FX_OBJS)
	$(CXX) $(STRIPFLAGS) -shared -o $@ $^ $(GUI_LDLIBS) -lm
clap: hds.clap
hds-fx: hds_fx.clap
run-backend: synth_engine
	./synth_engine

# --- Raspberry Pi 5 / aarch64 (ARM64_CFLAGS/LDFLAGS/BUNDLE_LIBS come from nix-shell) ---
ARM64_CC ?= aarch64-unknown-linux-gnu-gcc
ARM64_CXX ?= aarch64-unknown-linux-gnu-g++
ARM64_LIBDIR := arm64-libs
ARM64_OBJS := $(call objs,arm64,$(STANDALONE_UNITS) $(CORE_UNITS) $(FX_UNITS)) $(call nam_objs,arm64)

arm64: synth_engine-arm64
synth_engine-arm64: $(ARM64_OBJS) | arm64-check
	$(ARM64_CXX) $(STRIPFLAGS) -o $@ $(ARM64_OBJS) $(ARM64_LDFLAGS) -lasound -lm -lpthread -llo -lwavpack
	mkdir -p $(ARM64_LIBDIR)
	cp -Lf $(ARM64_BUNDLE_LIBS) $(ARM64_LIBDIR)/
	patchelf --set-rpath '$$ORIGIN/$(ARM64_LIBDIR)' --set-interpreter /lib/ld-linux-aarch64.so.1 $@
$(call objs,arm64,$(STANDALONE_UNITS) $(CORE_UNITS) $(FX_UNITS)): | arm64-check
.PHONY: arm64-check
arm64-check:
	@test -n "$(ARM64_CFLAGS)" || (echo "ARM64_CFLAGS not set -- run this from inside 'nix-shell' at the repo root" >&2; exit 1)

# --- Windows CLAP plugins (mingw-w64; WIN_EXTRA_* come from nix-shell) ---
WIN_CC ?= x86_64-w64-mingw32-gcc
WIN_CXX ?= x86_64-w64-mingw32-g++
WIN_DEPS := third_party/win64-deps
WIN_EXTRA_CFLAGS ?=
WIN_PTHREAD_LDLIBS ?= -lpthread
WIN_EXTRA_LDLIBS ?=
WIN_EXTRA_RUNTIME_DLLS ?=
WIN_CFLAGS := -O2 -Wall -Wextra -std=gnu11 -Isrc -DCAIRO_WIN32_STATIC_BUILD -I$(WIN_DEPS)/include -I$(WIN_DEPS)/include/cairo \
              -I$(WIN_DEPS)/include/lo -Ithird_party/clap/include $(NAM_INC) $(WIN_EXTRA_CFLAGS)
WIN_LDFLAGS := -static-libgcc -static-libstdc++ -L$(WIN_DEPS)/lib
WIN_LDLIBS := -lcairo -lpixman-1 -llo -lgdi32 -lmsimg32 -luser32 -lws2_32 -liphlpapi -lm \
              -Wl,-Bstatic $(WIN_PTHREAD_LDLIBS) -Wl,-Bdynamic $(WIN_EXTRA_LDLIBS)
WIN_CLAP_OBJS   := $(call objs,win,targets/clap/clap_plugin $(CORE_UNITS) $(FX_UNITS) $(FX_GUI_UNITS) $(TABS_SHARED) $(TABS_PER_HOST)) \
                   $(call nam_objs,win)
WIN_HDS_FX_OBJS := $(call objs,win,targets/fx_clap/hds_fx_plugin $(FX_UNITS) $(FX_GUI_UNITS)) $(call nam_objs,win)

clap-windows: hds-windows.clap
hds-fx-windows: hds_fx-windows.clap
hds-windows.clap: $(WIN_CLAP_OBJS)
	$(WIN_CXX) -shared $(STRIPFLAGS) $(WIN_LDFLAGS) -o $@ $^ $(WIN_LDLIBS)
	@if [ -n "$(WIN_EXTRA_RUNTIME_DLLS)" ]; then cp -f $(WIN_EXTRA_RUNTIME_DLLS) .; fi
hds_fx-windows.clap: $(WIN_HDS_FX_OBJS)
	$(WIN_CXX) -shared $(STRIPFLAGS) $(WIN_LDFLAGS) -o $@ $^ $(WIN_LDLIBS)
	@if [ -n "$(WIN_EXTRA_RUNTIME_DLLS)" ]; then cp -f $(WIN_EXTRA_RUNTIME_DLLS) .; fi

# --- Tests (tests/, run by tests/run_tests.sh; see the README's Testing section) ---
TEST_DIR := $(BUILD_DIR)/tests
TEST_BINS := $(addprefix $(TEST_DIR)/,test_backend test_fx_chain test_recording test_clap_render test_clap_osc test_clap_patches test_clap_gui test_standalone)
LINUX_NAM := $(call nam_objs,linux)
RECORDING_OBJ := $(call objs,linux-sa,core/recording_engine)

$(TEST_DIR)/%: tests/%.c tests/test_common.h tests/clap_test_host.h
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) $(GUI_CFLAGS) -MMD -MP -c $< -o $@.o
	$(CXX) -o $@ $@.o $(TEST_LINK) -lm
$(TEST_DIR)/test_backend:   TEST_LINK = $(call objs,linux,$(CORE_UNITS) $(FX_UNITS)) $(RECORDING_OBJ) $(LINUX_NAM) -llo -lwavpack -lpthread
$(TEST_DIR)/test_backend:   $(call objs,linux,$(CORE_UNITS) $(FX_UNITS)) $(RECORDING_OBJ) $(LINUX_NAM)
$(TEST_DIR)/test_fx_chain:  TEST_LINK = $(call objs,linux,$(FX_UNITS)) $(LINUX_NAM)
$(TEST_DIR)/test_fx_chain:  $(call objs,linux,$(FX_UNITS)) $(LINUX_NAM)
$(TEST_DIR)/test_recording: TEST_LINK = $(RECORDING_OBJ) -lwavpack -lpthread
$(TEST_DIR)/test_recording: $(RECORDING_OBJ)
$(TEST_DIR)/test_clap_render: TEST_LINK = -ldl
$(TEST_DIR)/test_clap_osc:    TEST_LINK = -ldl -llo
$(TEST_DIR)/test_clap_patches: TEST_LINK = -ldl -llo
$(TEST_DIR)/test_clap_gui:    TEST_LINK = -ldl $(GUI_LDLIBS)
$(TEST_DIR)/test_standalone:  TEST_LINK = -llo

test: synth_engine hds.clap hds_fx.clap $(TEST_BINS)
	tests/run_tests.sh $(TEST_DIR) ./hds.clap ./hds_fx.clap
test-golden: synth_engine hds.clap hds_fx.clap $(TEST_BINS)
	tests/run_tests.sh --update $(TEST_DIR) ./hds.clap ./hds_fx.clap

clean:
	rm -f synth_engine hds.clap hds_fx.clap synth_engine-arm64
	rm -rf $(ARM64_LIBDIR) $(BUILD_DIR)
clean-windows:
	rm -f hds-windows.clap hds_fx-windows.clap

# Compiler-generated header dependencies (-MMD -MP), for every object and test built so far.
-include $(shell find $(BUILD_DIR) -name '*.d' 2>/dev/null)
